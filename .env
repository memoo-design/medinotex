# ────────────────────────────────────────────────────────────────────────────
# MediNotex – Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ────────────────────────────────────────────────────────────────────────────

# ── Flask ────────────────────────────────────────────────────────────────────
SECRET_KEY=your-super-secret-key-change-me
FLASK_DEBUG=true

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite (default, no setup needed for development):
DATABASE_URL=sqlite:///medinotex.db

# PostgreSQL (recommended for production):
# DATABASE_URL=postgresql://username:password@localhost:5432/medinotex

# ── Azure Blob Storage ────────────────────────────────────────────────────────
# Find this in: Azure Portal → Storage Account → Access Keys
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=YOUR_ACCOUNT;AccountKey=YOUR_KEY;EndpointSuffix=core.windows.net
AZURE_BLOB_CONTAINER=clinical-notes

# ── Azure AI Language Service ─────────────────────────────────────────────────
# Find in: Azure Portal → Language Service → Keys and Endpoint
AZURE_LANGUAGE_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_LANGUAGE_KEY=your-32-char-key-here

# ── Azure Document Intelligence (Form Recognizer) ─────────────────────────────
# Find in: Azure Portal → Document Intelligence → Keys and Endpoint
AZURE_FORM_RECOGNIZER_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_FORM_RECOGNIZER_KEY=your-32-char-key-here

# ── CORS (comma-separated origins) ───────────────────────────────────────────
# For development, set to your frontend URL.
# For production, set to your actual domain.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:5500
