# ────────────────────────────────────────────────────────────────────────────
# MediNotex – Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ────────────────────────────────────────────────────────────────────────────

# ── Flask ────────────────────────────────────────────────────────────────────
SECRET_KEY=admin123
FLASK_DEBUG=true



# PostgreSQL (recommended for production):
 DATABASE_URL=postgresql://username:password@localhost:5432/medinotex

# ── Azure Blob Storage ────────────────────────────────────────────────────────
# Find this in: Azure Portal → Storage Account → Access Keys
# Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING= DefaultEndpointsProtocol=https;AccountName=doctoruploads;AccountKey=Irz6FlWS5Jho/r7bOjK/j2Iq4VzV8zXXI7EjtchMJ98R2qmqyeuU+JInE8SwjFho4GqGP2T3d63b+AStj/9M0A==;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER=documents

